#!name=高德地图去广告（修复版·经典语法）
#!desc=v2 · 过滤开屏广告、搜索栏热词、首页资源位与各页面推广，精简我的页面；老版本 Loon 用这一份
#!openUrl=https://apps.apple.com/cn/app/id461703208
#!author=RuCu6, kelv1n1n, 可莉🅥（原插件：https://hub.kelee.one）；本仓库为自托管修复版
#!homepage=https://github.com/Wansensr/loon-amap-adblock
#!icon=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/amap-icon.png
#!tag=去广告
#!system=iOS
#!system_version=
#!loon_version=3.2.4(787)
#!date=2026-10-13
#
# 经典 Rewrite 语法版（Loon 3.5.1(978) 之前的老配置用）。新版 Loon 请用 Amap-AdBlock.plugin。
# 迭代：v1 修复开屏；v2 补齐热词/资源位/各页面推广（对齐原插件规则 + 自托管脚本）。

[Rule]
DOMAIN, amap-aos-info-nogw.amap.com, REJECT
DOMAIN, free-aos-cdn-image.amap.com, REJECT
DOMAIN, optimus-ads.amap.com, REJECT
DOMAIN-SUFFIX, v.smtcdns.com, REJECT

[Rewrite]
# ============ 开屏广告 ============
^https:\/\/([a-z0-9-]+\.)*amap\.com\/ws\/valueadded\/alimama\/splash_screen reject-dict

# ============ 搜索栏热词 / 搜索页推广 ============
^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword\? reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\? reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\? response-body-json-del data.commonMaterial data.tipsOperationLocation data.resourcePlacement
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/homepage\? response-body-json-del history_tags

# ============ 首页资源位 / 运营推广 ============
^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/\? reject-dict
^https:\/\/ai\.amap\.com\/v1\/ai_rec\/ reject-dict
^https:\/\/m5\.amap\.com\/ws\/aos\/main\/page\/product\/list\? reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:main-page-assets|main-page-location|ridewalk-end-fc|usr-profile-fc\/homeV2) reject-dict
^https:\/\/m5\.amap\.com\/ws\/(?:mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword) reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? reject-dict
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?:car-end|route-plan) reject-dict
^https:\/\/m5\.amap\.com\/ws\/valueadded\/weather\/v2\? reject-dict
^https:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\? reject-dict

# ============ 打车 / 订单页推广 ============
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:order\/car\/(?:feedback\/get_card_questions|feedback\/viptips|king_toolbox_car_bubble|remark\/satisfactionConf|rights_information)|tips\/onscene_visual_optimization) reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving) reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\? response-body-json-del data.carTips.data.popupInfo

[Script]
# ============ 需要改响应体才能摘干净的推广（脚本已随本仓库自托管） ============
http-response ^https:\/\/m5\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除路线规划推广
http-response ^https:\/\/m5\.amap\.com\/ws\/bus\/plan\/integrate\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除路线规划、导航结束页推广
http-response ^https:\/\/m5\.amap\.com\/ws\/c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除导航详情页底部酒店、处理附近页
http-response ^https:\/\/m5\.amap\.com\/ws\/perception\/drive\/(?:routeInfo|routePlan) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除路线规划推广
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/search_bff\/hotword\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除搜索栏推广
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(?:mps|search\/sp|sug|tips_operation_location) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除搜索详情页推广
http-response ^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:card-service-plan-home|main-page) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除首页推广
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除首页推广
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除我的页面推广
http-response ^https:\/\/m5\.amap\.com\/ws\/shield\/search\/nearbyrec_smart\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除附近页推广
http-response ^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:car\/order\/content_info|order_web\/friendly_information) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除打车页推广卡片、弹窗
http-response ^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\? script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除打车页红点角标、天气图标
http-response ^https:\/\/(?:info|m5)\.amap\.com\/ws\/shield\/search\/(?:common\/coupon\/info|poi\/detail) script-path=https://raw.githubusercontent.com/Wansensr/loon-amap-adblock/main/Amap_remove_ads.js, requires-body=true, tag=移除导航详情页推广

[Mitm]
hostname=*.amap.com
